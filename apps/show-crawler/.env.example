# Copie para .env (nunca versionado).

# Supabase do sistema de gestão. Sem estas duas variáveis o crawler grava em arquivos (data/).
# A chave é a "service_role" (secreta): só neste arquivo local, nunca no frontend nem no repositório.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Raças a coletar, pelo nome como aparece na fonte, separadas por vírgula.
CRAWLER_BREEDS=SHIBA

# Cães do canil quando não há Supabase configurado: números de registro separados por vírgula.
CRAWLER_DOG_REGISTRATIONS=

# Intervalo mínimo entre requisições à mesma fonte, em milissegundos.
CRAWLER_MIN_INTERVAL_MS=1500
