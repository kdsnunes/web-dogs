{
  "name": "show-crawler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Coletor de calendários e resultados de exposições caninas, com uma fonte por adaptador (projeto isolado do monorepo web-dogs).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "crawl": "node --disable-warning=DEP0040 --import tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "cheerio": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
