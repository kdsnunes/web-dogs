---
interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const {
  title = 'Kennel Club de Londrina',
  description = 'Kennel Club de Londrina (KCL): entidade cinófila de Londrina/PR dedicada ao registro, pedigree e ao aprimoramento das raças caninas.',
  active = '',
} = Astro.props;

const siteName = 'Kennel Club de Londrina';
const year = new Date().getFullYear();

const nav = [
  { label: 'Home', href: '/', key: 'home' },
  { label: 'Institucional', href: '/institucional/', key: 'institucional' },
  { label: 'Serviços', href: '/servicos/', key: 'servicos' },
  { label: 'Formulários', href: '/formularios/', key: 'formularios' },
  { label: 'Contato', href: '/contato/', key: 'contato' },
];
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo.png" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="theme-color" content="#B01E2E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="topbar">
      <div class="topbar-inner">
        <span class="topbar-item">Entidade cinófila de Londrina — Paraná</span>
        <div class="topbar-links">
          <a href="https://wa.me/5543999999999" target="_blank" rel="noopener">WhatsApp</a>
          <a href="mailto:contato@kclondrina.com.br">contato@kclondrina.com.br</a>
        </div>
      </div>
    </div>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="Kennel Club de Londrina — início">
          <img src="/logo.png" alt="Kennel Club de Londrina" width="60" height="61" />
          <span class="brand-text">
            <strong>Kennel Club de Londrina</strong>
            <small>Filiado a CBKC e FCI</small>
          </span>
        </a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="nav-burger" aria-label="Abrir menu">
          <span></span><span></span><span></span>
        </label>

        <nav class="site-nav">
          {nav.map((item) => (
            <a href={item.href} class={active === item.key ? 'is-active' : ''}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-affiliations">
        <span class="footer-affiliations-label">Filiado a</span>
        <div class="footer-affiliations-logos">
          <a href="https://www.cbkc.org/" target="_blank" rel="noopener" aria-label="Confederação Brasileira de Cinofilia (CBKC)">
            <img src="/cbkc.png" alt="CBKC — Confederação Brasileira de Cinofilia" width="72" height="72" loading="lazy" />
          </a>
          <a href="https://www.fci.be/" target="_blank" rel="noopener" aria-label="Fédération Cynologique Internationale (FCI)">
            <img src="/fci.png" alt="FCI — Fédération Cynologique Internationale" width="72" height="72" loading="lazy" />
          </a>
        </div>
      </div>
      <div class="footer-inner">
        <div class="footer-col footer-brand">
          <img src="/logo.png" alt="Kennel Club de Londrina" width="72" height="73" />
          <p>Kennel Club de Londrina</p>
          <span>Amor, dedicação e ética à cinofilia paranaense.</span>
        </div>
        <div class="footer-col">
          <h4>Navegação</h4>
          <a href="/">Home</a>
          <a href="/institucional/">Institucional</a>
          <a href="/servicos/">Serviços</a>
          <a href="/formularios/">Formulários</a>
          <a href="/contato/">Contato</a>
        </div>
        <div class="footer-col">
          <h4>Serviços</h4>
          <a href="/servicos/#registros">Registros</a>
          <a href="/servicos/#pedigree">Pedigree</a>
          <a href="/servicos/#homologacao">Homologação de Títulos</a>
          <a href="/servicos/#socios">Sócios</a>
          <a href="/servicos/#taxas">Taxas</a>
        </div>
        <div class="footer-col">
          <h4>Contato</h4>
          <a href="tel:+5543999999999">(43) 99999-9999</a>
          <a href="mailto:contato@kclondrina.com.br">contato@kclondrina.com.br</a>
          <span>Londrina — Paraná / PR</span>
          <div class="footer-social">
            <a href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram">Instagram</a>
            <a href="https://www.facebook.com/" target="_blank" rel="noopener" aria-label="Facebook">Facebook</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {year} Kennel Club de Londrina. Todos os direitos reservados.</span>
        <span>KCL · Londrina / PR</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    /* Paleta inspirada no brasão de Londrina e no logotipo do KCL */
    --vermelho: #B01E2E;      /* cruz de São Jorge / vermelho do selo KCL */
    --vermelho-escuro: #8A1622;
    --vermelho-claro: #D23B4A;
    --verde: #1E7A3D;         /* ramos de café do brasão */
    --verde-escuro: #155C2D;
    --prata: #C9CDD2;         /* campo prata do escudo / anel do selo */
    --prata-clara: #EDEFF1;
    --cinza-fundo: #F5F6F8;
    --branco: #FFFFFF;
    --tinta: #1F2328;
    --texto: #3A3F45;
    --texto-suave: #6B7178;
    --borda: #E1E4E8;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; overflow-x: hidden; }
  html, body {
    background: var(--cinza-fundo);
    color: var(--texto);
    font-family: "Source Sans 3", system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4 {
    font-family: "Barlow Condensed", "Source Sans 3", sans-serif;
    color: var(--tinta);
    line-height: 1.12;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }
  h1 { font-size: clamp(2.1rem, 5vw, 3.2rem); font-weight: 700; }
  h2 { font-size: clamp(1.6rem, 3.5vw, 2.2rem); font-weight: 700; }
  h3 { font-size: 1.25rem; font-weight: 600; }

  a { color: var(--vermelho); text-decoration: none; }
  img { max-width: 100%; height: auto; display: block; }

  /* ── Top bar ── */
  .topbar {
    background: var(--tinta);
    color: #D7DADE;
    font-size: 0.82rem;
  }
  .topbar-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 7px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .topbar-links { display: flex; gap: 20px; }
  .topbar a { color: #D7DADE; transition: color 0.2s; }
  .topbar a:hover { color: #fff; }
  @media (max-width: 680px) {
    .topbar-item { display: none; }
    .topbar-inner { justify-content: center; }
  }

  /* ── Header ── */
  .site-header {
    background: var(--branco);
    border-bottom: 3px solid var(--vermelho);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
  }
  .header-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand { display: flex; align-items: center; gap: 14px; }
  .brand img { border-radius: 50%; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-text strong {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--tinta);
  }
  .brand-text small { color: var(--texto-suave); font-size: 0.78rem; letter-spacing: 0.5px; }

  .site-nav { display: flex; gap: 6px; }
  .site-nav a {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--tinta);
    padding: 8px 14px;
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
  }
  .site-nav a:hover { background: var(--prata-clara); color: var(--vermelho); }
  .site-nav a.is-active { color: var(--vermelho); border-bottom: 2px solid var(--vermelho); border-radius: 0; }

  .nav-toggle, .nav-burger { display: none; }
  .nav-burger { flex-direction: column; gap: 5px; cursor: pointer; padding: 8px; }
  .nav-burger span { width: 26px; height: 2.5px; background: var(--tinta); border-radius: 2px; }

  @media (max-width: 860px) {
    .brand-text small { display: none; }
    .nav-burger { display: flex; }
    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background: var(--branco);
      border-bottom: 3px solid var(--vermelho);
      padding: 8px 16px 16px;
      gap: 2px;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
      box-shadow: 0 12px 20px rgba(0,0,0,0.08);
    }
    .nav-toggle:checked ~ .site-nav { max-height: 340px; }
    .site-nav a { padding: 12px 10px; border-bottom: 1px solid var(--borda); }
    .site-nav a.is-active { border-bottom: 1px solid var(--vermelho); }
  }

  /* ── Layout utils ── */
  .container { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 4rem 0; }
  .section-alt { background: var(--branco); }
  .lead { font-size: 1.12rem; color: var(--texto); }
  .center { text-align: center; }
  .muted { color: var(--texto-suave); }

  .section-head { max-width: 760px; margin: 0 auto 2.6rem; text-align: center; }
  .eyebrow {
    font-family: "Barlow Condensed", sans-serif;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 600;
    color: var(--vermelho);
    font-size: 0.95rem;
    display: inline-block;
    margin-bottom: 0.5rem;
  }
  .section-head p { margin-top: 0.8rem; color: var(--texto-suave); }

  .rule {
    width: 64px; height: 3px; background: var(--vermelho);
    border: none; margin: 0.9rem auto 0;
  }

  /* ── Buttons ── */
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 600; font-size: 1.05rem;
    text-transform: uppercase; letter-spacing: 0.8px;
    padding: 12px 26px; border-radius: 4px;
    background: var(--vermelho); color: #fff;
    border: 2px solid var(--vermelho);
    transition: all 0.2s ease; cursor: pointer;
  }
  .btn:hover { background: var(--vermelho-escuro); border-color: var(--vermelho-escuro); }
  .btn-outline { background: transparent; color: var(--vermelho); }
  .btn-outline:hover { background: var(--vermelho); color: #fff; }
  .btn-green { background: var(--verde); border-color: var(--verde); }
  .btn-green:hover { background: var(--verde-escuro); border-color: var(--verde-escuro); }

  /* ── Cards ── */
  .cards { display: grid; gap: 1.4rem; }
  .cards-3 { grid-template-columns: repeat(3, 1fr); }
  .cards-2 { grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 880px) { .cards-3 { grid-template-columns: 1fr; } .cards-2 { grid-template-columns: 1fr; } }

  .card {
    background: var(--branco);
    border: 1px solid var(--borda);
    border-top: 4px solid var(--vermelho);
    border-radius: 8px;
    padding: 1.8rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .card:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(0,0,0,0.08); }
  .card h3 { margin-bottom: 0.6rem; color: var(--tinta); }
  .card p { font-size: 0.98rem; }
  .card .card-link {
    display: inline-block; margin-top: 1rem;
    font-family: "Barlow Condensed", sans-serif;
    text-transform: uppercase; letter-spacing: 1px; font-weight: 600;
    color: var(--vermelho);
  }
  .card-icon {
    width: 52px; height: 52px; border-radius: 8px;
    background: var(--prata-clara); color: var(--vermelho);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 1rem;
  }

  /* ── Footer ── */
  .site-footer { background: var(--tinta); color: #C7CBD0; margin-top: 2rem; }
  .footer-affiliations {
    display: flex; flex-direction: column; align-items: center; gap: 0.9rem;
    padding: 2.4rem 24px;
    background: #fff;
    border-top: 3px solid var(--vermelho);
  }
  .footer-affiliations-label {
    font-family: "Barlow Condensed", sans-serif;
    text-transform: uppercase; letter-spacing: 2px; font-weight: 600;
    color: var(--texto-suave); font-size: 0.9rem;
  }
  .footer-affiliations-logos { display: flex; align-items: center; gap: 2.4rem; flex-wrap: wrap; justify-content: center; }
  .footer-affiliations-logos img {
    height: 72px; width: auto;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .footer-affiliations-logos a:hover img { transform: translateY(-3px); filter: drop-shadow(0 6px 12px rgba(0,0,0,0.15)); }
  .footer-inner {
    max-width: 1140px; margin: 0 auto; padding: 3.2rem 24px 2rem;
    display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 2rem;
  }
  .footer-col h4 {
    color: #fff; font-size: 1.05rem; margin-bottom: 1rem;
    letter-spacing: 1px;
  }
  .footer-col a, .footer-col span { display: block; color: #C7CBD0; font-size: 0.92rem; padding: 3px 0; transition: color 0.2s; }
  .footer-col a:hover { color: #fff; }
  .footer-brand img { border-radius: 50%; margin-bottom: 0.8rem; }
  .footer-brand p { color: #fff; font-family: "Barlow Condensed", sans-serif; font-size: 1.2rem; text-transform: uppercase; letter-spacing: 0.5px; }
  .footer-brand span { color: #9BA1A8; font-size: 0.88rem; }
  .footer-social { display: flex; gap: 14px; margin-top: 0.6rem; }
  .footer-social a { display: inline; color: var(--prata); font-weight: 600; }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
    max-width: 1140px; margin: 0 auto; padding: 1.2rem 24px;
    display: flex; justify-content: space-between; gap: 10px;
    font-size: 0.82rem; color: #8B9198; flex-wrap: wrap;
  }
  @media (max-width: 860px) { .footer-inner { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer-inner { grid-template-columns: 1fr; } }
</style>
