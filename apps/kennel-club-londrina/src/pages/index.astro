---
import BaseLayout from '../layouts/BaseLayout.astro';

const servicos = [
  {
    titulo: 'Como registrar uma ninhada',
    texto: 'É o processo pelo qual o sócio encaminha as informações da sua criação para a obtenção dos pedigrees dos filhotes.',
    href: '/servicos/#registros',
  },
  {
    titulo: 'Como abrir um canil',
    texto: 'É o processo pelo qual o proprietário de um ou mais exemplares com pedigree obtém o afixo — o nome do seu canil — utilizado na sua criação.',
    href: '/servicos/#registros',
  },
  {
    titulo: 'Transferência de Propriedade',
    texto: 'É o procedimento por meio do qual o comprador de um cão com pedigree realiza a transferência de propriedade do exemplar.',
    href: '/servicos/#pedigree',
  },
];
---
<BaseLayout
  title="Kennel Club de Londrina — Cinofilia em Londrina/PR"
  description="Kennel Club de Londrina (KCL): entidade cinófila dedicada ao registro de ninhadas, pedigree e ao aprimoramento das raças caninas em Londrina, Paraná."
  active="home"
>
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-inner">
      <span class="hero-eyebrow">Faça parte do</span>
      <h1>Kennel Club de Londrina</h1>
      <p class="hero-sub">A cinofilia de Londrina reunida em torno do bem-estar, da ética e do aprimoramento das raças caninas.</p>
      <div class="hero-actions">
        <a href="/servicos/" class="btn">Nossos serviços</a>
        <a href="/institucional/" class="btn btn-outline btn-outline-light">Conheça o KCL</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Comece por aqui</span>
        <h2>Principais serviços</h2>
        <hr class="rule" />
      </div>
      <div class="cards cards-3">
        {servicos.map((s) => (
          <div class="card">
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
            <a class="card-link" href={s.href}>Saiba mais →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container about-grid">
      <div class="about-media">
        <img src="/brasao-londrina.png" alt="Brasão do município de Londrina" width="300" height="324" loading="lazy" />
      </div>
      <div class="about-text">
        <span class="eyebrow">Institucional</span>
        <h2>Kennel Club de Londrina</h2>
        <p>
          O <strong>Kennel Club de Londrina</strong> é uma entidade cinófila situada em Londrina, no
          norte do Paraná, dedicada a congregar os cinófilos da região e a cuidar dos interesses
          de todas as raças caninas.
        </p>
        <p>
          Com trabalho, amor e dedicação à cinofilia, o <strong>KCL</strong> promove o desenvolvimento
          cultural e desportivo por meio de atividades que visam ao <strong>aprimoramento das raças
          caninas</strong>, seguindo os padrões e as diretrizes do sistema oficial da cinofilia brasileira.
        </p>
        <p>
          Oferecer o suporte necessário para a <strong>criação ética e responsável de cães</strong> em
          Londrina e região é o nosso compromisso constante. Nossa missão é preservar o patrimônio
          genético constituído junto aos nossos associados, zelando sempre pelo bem-estar animal.
        </p>
        <a href="/institucional/" class="btn btn-green">Saiba mais</a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta-inner">
      <h2>Torne-se sócio do KCL</h2>
      <p>Participe da cinofilia londrinense e conte com o suporte do Kennel Club de Londrina para a sua criação.</p>
      <a href="/contato/" class="btn btn-outline btn-outline-light">Fale com o clube</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    background:
      linear-gradient(135deg, rgba(138,22,34,0.96), rgba(176,30,46,0.88)),
      radial-gradient(circle at 80% 20%, rgba(30,122,61,0.35), transparent 55%);
    color: #fff;
    overflow: hidden;
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    padding: 5.5rem 24px 5rem;
    max-width: 820px;
  }
  .hero-eyebrow {
    font-family: "Barlow Condensed", sans-serif;
    text-transform: uppercase; letter-spacing: 3px; font-weight: 600;
    font-size: 1rem; color: rgba(255,255,255,0.85);
  }
  .hero h1 { color: #fff; margin: 0.4rem 0 1rem; }
  .hero-sub { font-size: 1.2rem; color: rgba(255,255,255,0.92); max-width: 640px; }
  .hero-actions { display: flex; gap: 14px; margin-top: 2rem; flex-wrap: wrap; }
  .btn-outline-light { color: #fff; border-color: #fff; background: transparent; }
  .btn-outline-light:hover { background: #fff; color: var(--vermelho); }

  .about-grid {
    display: grid; grid-template-columns: 320px 1fr; gap: 3rem; align-items: center;
  }
  .about-media { display: flex; justify-content: center; }
  .about-media img { filter: drop-shadow(0 12px 24px rgba(0,0,0,0.12)); }
  .about-text .eyebrow { margin-bottom: 0.4rem; }
  .about-text h2 { margin-bottom: 1rem; }
  .about-text p { margin-bottom: 1rem; }
  .about-text .btn { margin-top: 0.6rem; }
  @media (max-width: 880px) {
    .about-grid { grid-template-columns: 1fr; gap: 2rem; }
    .about-media img { max-width: 220px; }
  }

  .cta {
    background: var(--tinta);
    color: #fff;
    background-image: linear-gradient(120deg, var(--verde-escuro), var(--verde));
  }
  .cta-inner { padding: 3.5rem 24px; text-align: center; }
  .cta h2 { color: #fff; }
  .cta p { color: rgba(255,255,255,0.9); max-width: 560px; margin: 0.8rem auto 1.8rem; }
</style>
