---
import BaseLayout from '../layouts/BaseLayout.astro';

const formularios = [
  { titulo: 'Registro de Ninhadas', tipo: 'Acesse', href: 'https://cbkc.org/application/views/docs/forms/forms-mapa_ninhadas.pdf' },
  { titulo: 'Registro de Afixo', tipo: 'Acesse', href: 'https://cbkc.org/application/views/docs/forms/forms-registro_afixo.pdf' },
  { titulo: 'Contrato de Co-Propriedade', tipo: 'Acesse', href: 'https://cbkc.org/application/views/docs/forms/forms-contrato_copropriedade.pdf' },
  { titulo: 'Requerimento para Homologação de Títulos', tipo: 'Acesse', href: 'https://cbkc.org/application/views/docs/forms/forms-homologacao_titulos.pdf' },
  { titulo: 'Declaração de Transferência', tipo: 'Acesse', href: 'https://cbkc.org/application/views/docs/forms/forms-declaracao_transferencia_filhotes_registro.pdf' },
  { titulo: 'Solicitação de 2ª via de Certificado de Registro de Canil', tipo: 'Acesse', href: 'https://cbkc.org/application/views/docs/forms/forms-certificado_registro_canil.pdf' },
  { titulo: 'Solicitação de Transferência de Propriedade de Afixo', tipo: 'Acesse', href: 'https://cbkc.org/application/views/docs/forms/forms-transferencia_propriedade_afixo.pdf' },
  { titulo: 'Solicitação de 2ª via de Pedigree', tipo: 'Acesse', href: 'https://cbkc.org/application/views/docs/forms/forms-segundavia_pedigree.pdf' },
  { titulo: 'Registro Inicial (R.I.)', tipo: 'Acesse', href: 'https://cbkc.org/formularios/ver/avaliacao_registro_inicial' },
];

const socios = [
  { titulo: 'Proposta de Sócio (Frente)', tipo: 'Download', href: 'https://www.brasilkennelclub.com.br/uploads/proposta-socio-frente.pdf' },
  { titulo: 'Proposta de Sócio (Verso)', tipo: 'Download', href: 'https://www.brasilkennelclub.com.br/uploads/proposta-socio-verso.pdf' },
];
---
<BaseLayout
  title="Formulários — Kennel Club de Londrina"
  description="Formulários utilizados nos serviços do Kennel Club de Londrina: registro de ninhadas, afixo, pedigree, homologação de títulos, transferências e proposta de sócio."
  active="formularios"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow eyebrow-light">Formulários</span>
      <h1>Formulários</h1>
      <p>O Kennel Club de Londrina disponibiliza abaixo os formulários utilizados nos serviços prestados pelo clube.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="forms-grid">
        {formularios.map((f) => (
          <a class="form-item" href={f.href} target="_blank" rel="noopener">
            <div class="form-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <span class="form-title">{f.titulo}</span>
            <span class="form-action">{f.tipo}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="socios">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Associe-se</span>
        <h2>Proposta de Sócio</h2>
        <hr class="rule" />
        <p>Preencha a proposta de sócio e envie à secretaria do clube para se associar ao Kennel Club de Londrina.</p>
      </div>
      <div class="forms-grid forms-grid-2">
        {socios.map((f) => (
          <a class="form-item form-item-green" href={f.href} target="_blank" rel="noopener">
            <div class="form-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            </div>
            <span class="form-title">{f.titulo}</span>
            <span class="form-action">{f.tipo}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </a>
        ))}
      </div>
      <p class="center muted note">Os formulários oficiais de registro seguem o padrão do sistema cinófilo brasileiro (CBKC). Em caso de dúvidas sobre o preenchimento, entre em <a href="/contato/">contato</a> com o clube.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--vermelho-escuro), var(--vermelho));
    color: #fff; padding: 3.5rem 0;
  }
  .page-hero h1 { color: #fff; margin: 0.4rem 0 0.6rem; }
  .page-hero p { color: rgba(255,255,255,0.9); max-width: 640px; }
  .eyebrow-light { color: rgba(255,255,255,0.85); }

  .forms-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .forms-grid-2 { grid-template-columns: repeat(2, 1fr); max-width: 760px; margin: 0 auto; }
  @media (max-width: 880px) { .forms-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .forms-grid, .forms-grid-2 { grid-template-columns: 1fr; } }

  .form-item {
    background: var(--branco);
    border: 1px solid var(--borda);
    border-left: 4px solid var(--vermelho);
    border-radius: 8px;
    padding: 1.3rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    color: var(--tinta);
  }
  .form-item:hover { transform: translateY(-3px); box-shadow: 0 12px 26px rgba(0,0,0,0.08); }
  .form-item-green { border-left-color: var(--verde); }
  .form-icon {
    width: 44px; height: 44px; border-radius: 8px;
    background: var(--prata-clara); color: var(--vermelho);
    display: flex; align-items: center; justify-content: center;
  }
  .form-item-green .form-icon { color: var(--verde); }
  .form-title { font-weight: 600; font-size: 1rem; line-height: 1.35; flex: 1; }
  .form-action {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: "Barlow Condensed", sans-serif;
    text-transform: uppercase; letter-spacing: 1px; font-weight: 600;
    color: var(--vermelho); font-size: 0.95rem;
  }
  .form-item-green .form-action { color: var(--verde-escuro); }
  .note { margin-top: 2.4rem; max-width: 640px; margin-left: auto; margin-right: auto; font-size: 0.95rem; }
</style>
